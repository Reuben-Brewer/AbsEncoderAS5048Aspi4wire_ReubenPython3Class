void InitializeDebuggingSerial()
{
    /*
    Needed for native USB port only. optional on Teensy. 
    USB hardware initialization is performed before setup() runs. 
    The baud rate input is ignored, and only used for Arduino compatibility.
    USB serial communication always occurs at full USB speed.

    Serial.begin(9600);
    while (!Serial) 
    {
      ;  // wait for serial port to connect. 
    }
    */

    DebuggingSerialConnectedFlag = 1;
      
}
////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////

////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////
void SendStringOverDebuggingSerialImmediately(String StringToSend)
{

  /* Serial.write() can write individual bytes or arrays of bytes (like character arrays).
    Serial.print() converts ints, floats, etc. to strings and calls Serial.write() to send the string. */

  /* //Also works
  for (unsigned int i = 0; i < StringToSend.length(); i++)
  {
    Serial.write(StringToSend[i]);   // Push each char 1 by 1 on each loop pass
  }
  */

  Serial.write(StringToSend.c_str());
  Serial.send_now(); //Transmit any buffered data as soon as possible
}
