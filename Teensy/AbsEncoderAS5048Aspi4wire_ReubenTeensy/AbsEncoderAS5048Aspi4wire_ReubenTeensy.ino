void InitializeSPI_AS5048A()
{

  /*
  //Alternative method to using the "SPI0_Settings" method. SEEMS TO RESULT IN BAD DATA.
  SPI.setBitOrder(MSBFIRST);
  SPI.setDataMode(SPI_MODE1);
  SPI.setClockDivider(SPI_CLOCK_DIV32);
  */

  if(SPI_ChannelNumber0or1 == 0)
  {
    pinMode(SPI_CS_0_0, OUTPUT);

    //SPI.setCS(SPI_CS0_0); //THIS LINE RESULTS IN RECEIVING ALL 0XFF VALUES, NOT SURE WHY. THE OTHER SPI.setPINS FUNCTIONS WORK.
    SPI.setMOSI(SPI_MOSI_0);
    SPI.setMISO(SPI_MISO_0);
    SPI.setSCK(SPI_CLK_0);

    SPI.begin();
  }
  else if(SPI_ChannelNumber0or1 == 1)
  {
    pinMode(SPI_CS_1_0, OUTPUT);

    ///*
    //SPI1.setCS(SPI_CS_1_0); //THIS LINE RESULTS IN RECEIVING ALL 0XFF VALUES, NOT SURE WHY. THE OTHER SPI.setPINS FUNCTIONS WORK.
    SPI1.setMOSI(SPI_MOSI_1);
    SPI1.setMISO(SPI_MISO_1);
    SPI1.setSCK(SPI_CLK_1);
    
    SPI1.begin(); //NOTE THAT THIS IS A DIFFERENT OBJECT ("SPI1.") INSTEAD OF "SPI."!
  }

}
