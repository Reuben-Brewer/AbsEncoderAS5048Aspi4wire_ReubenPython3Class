double ConvertDoubleToNumberOfDecimalPlaces(double InputNumber, int NumberOfDecimalPlaces)
{
  double PowerNumber = pow(10, NumberOfDecimalPlaces);
  double OutputNumber = round(InputNumber*PowerNumber)/PowerNumber;

  return OutputNumber;
}
////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////

////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////
double SinusoidalInput_UpdateValue(double MagnitudeOfRandomNoiseToAdd)
{
  double RandomNoise = MagnitudeOfRandomNoiseToAdd*random(0, 1000)/1000.0;

  double SinusoidalInput_TimeGain = PI/(2.0 * SinusoidalInput_HalfPeriodInSeconds);
  SinusoidalInput_CalculatedValue = RandomNoise + (SinusoidalInput_MaxValue + SinusoidalInput_MinValue)/2.0 + 0.5*abs(SinusoidalInput_MaxValue - SinusoidalInput_MinValue)*sin(SinusoidalInput_TimeGain*CurrentTimeInMilliseconds/1000.0);

  return SinusoidalInput_CalculatedValue;
}
