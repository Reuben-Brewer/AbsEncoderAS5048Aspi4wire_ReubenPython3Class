////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////
const double LoopFrequencyHz = 400.0; //400Hz works great for only Time, DebugVar (~42 Bytes/message). //150Hz works great for Time, AngleFloatDegrees, AnalogSensor_Value_AO0, DebugVar (~102 Bytes/message)

const int SPI_ChannelNumber0or1 = 1;

const int LEDpin = LED_BUILTIN;  // the number of the BuiltIn (orange) LED pin //#define LED_BUILTIN   (13), conflicts with SPI0 SCK0 - PIN 13 
unsigned int LEDstate = 0;  // LEDstate used to set the BuiltIn (orange) LED

unsigned long CurrentTimeInMilliseconds = millis();
unsigned long LastTimeInMilliseconds = millis();

const int AnalogSensor_Pin_AO0 = A0;
int AnalogSensor_Value_AO0 = 0;

uint8_t AngleByte_MSB;
uint8_t AngleByte_LSB;
uint16_t AngleInt;
double AngleFloatDegrees;

double SinusoidalInput_CalculatedValue = 0.0;

double DebugVar = 0.0;

SPISettings SPI0and1_Settings(10000000, MSBFIRST, SPI_MODE1); //SPI_MODE1 is specified in the AS5048A datasheet as "Wire_mode = 1". Speed = 1953000 works, as does 10000000.

bool DebuggingSerialConnectedFlag = 0;
bool HardwareSerial2ConnectedFlag = 0;

JsonDocument JSONdoc; //Allocate the JSON document. To make a variable global, just declare it outside of any function, preferably before the setup function.
