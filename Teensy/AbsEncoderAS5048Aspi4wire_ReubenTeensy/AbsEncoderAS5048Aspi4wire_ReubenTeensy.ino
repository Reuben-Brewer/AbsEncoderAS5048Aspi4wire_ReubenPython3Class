////////////////////////////////////////////////////////////////////////////////////////////////////

////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////
void ReadSPI_AS5048A(int SendSerialDebuggingFlag)
{

    ////////////////////////////////////////////////////////////////////////////////////////////////////
    if(SPI_ChannelNumber0or1 == 0)
    {
      SPI.beginTransaction(SPI0and1_Settings);

      digitalWriteFast(SPI_CS_0_0, LOW);

      AngleByte_MSB = SPI.transfer(0xFF); //AS5048A requires an 0xFFFF to be sent to get the last anglular value. Non-blocking.
      AngleByte_LSB = SPI.transfer(0xFF); //Non-blocking.
    }
    else if(SPI_ChannelNumber0or1 == 1)
    {
      SPI1.beginTransaction(SPI0and1_Settings);

      digitalWriteFast(SPI_CS_1_0, LOW);

      AngleByte_MSB = SPI1.transfer(0xFF); //AS5048A requires an 0xFFFF to be sent to get the last anglular value. Non-blocking.
      AngleByte_LSB = SPI1.transfer(0xFF); //Non-blocking.
    }
    ////////////////////////////////////////////////////////////////////////////////////////////////////

    ////////////////////////////////////////////////////////////////////////////////////////////////////
    AngleInt = 1.0*( ( (AngleByte_MSB & 0b00111111) << 8) | (AngleByte_LSB & 0b11111111) );  //0x3F = 0b00111111, & 0x3FFF.
    AngleFloatDegrees = 360.0 * (AngleInt / 16383.0);  //0x3FFF = 16383 = 2^14-1 = max value
    ////////////////////////////////////////////////////////////////////////////////////////////////////

    ////////////////////////////////////////////////////////////////////////////////////////////////////
    if(SPI_ChannelNumber0or1 == 0)
    {
      digitalWriteFast(SPI_CS_0_0, HIGH);
      SPI.endTransaction();
    }
    else if(SPI_ChannelNumber0or1 == 1)
    {
      digitalWriteFast(SPI_CS_1_0, HIGH);
      SPI1.endTransaction();
    }
    ////////////////////////////////////////////////////////////////////////////////////////////////////

    ////////////////////////////////////////////////////////////////////////////////////////////////////
    if(SendSerialDebuggingFlag == 1)
    {
      if(HardwareSerial2ConnectedFlag == 1)
      {
        Serial.println("ReadSPI: MSB: " + String(AngleByte_MSB) + ", LSB: " + String(AngleByte_LSB) + ", AngleInt: " + String(AngleInt) + ", AngleFloat: " + String(AngleFloatDegrees));
      }
    }
    ////////////////////////////////////////////////////////////////////////////////////////////////////

}
