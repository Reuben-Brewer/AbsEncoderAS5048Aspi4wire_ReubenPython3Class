void ReadAnalogInputs(int SendSerialDebuggingFlag)
{
  AnalogSensor_Value_AO0 = analogRead(AnalogSensor_Pin_AO0);

  if(SendSerialDebuggingFlag == 1)
  {
      if(HardwareSerial2ConnectedFlag == 1)
      {
        Serial.println("AO0 = " + String(AnalogSensor_Value_AO0)); //println vs 2 .writes
      }
  }
}
