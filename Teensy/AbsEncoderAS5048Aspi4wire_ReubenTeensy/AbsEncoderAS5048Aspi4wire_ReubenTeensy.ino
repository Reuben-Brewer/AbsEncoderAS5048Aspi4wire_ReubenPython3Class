#define SPI_CS_0_0  10 //software or hardware SPI
#define SPI_MOSI_0  11 //hardware SPI
#define SPI_MISO_0  12 //hardware SPI
#define SPI_CLK_0  13 //hardware SPI

#define SPI_CS_1_0  0 //software or hardware SPI
#define SPI_MOSI_1  26 //hardware SPI
#define SPI_MISO_1  1 //hardware SPI
#define SPI_CLK_1  27 //hardware SPI

#define HardwareSerial2_BaudRate 2000000//Max 2000000 for non-Teensy, fast Arduino boards, also for Teensy 4.1 HardwareSerial2 with FTDI TTL-232RG-VREG3V3-WE (even though the spec. sheet says 3MBaus is the max)

#define SERIAL_TX_BUFFER_SIZE 1 //DOESN'T APPEAR TO BE WORKING
#define SERIAL_RX_BUFFER_SIZE 64 //DOESN'T APPEAR TO BE WORKING

#define SinusoidalInput_HalfPeriodInSeconds 2.0
#define SinusoidalInput_MinValue -20.0
#define SinusoidalInput_MaxValue 20.0
