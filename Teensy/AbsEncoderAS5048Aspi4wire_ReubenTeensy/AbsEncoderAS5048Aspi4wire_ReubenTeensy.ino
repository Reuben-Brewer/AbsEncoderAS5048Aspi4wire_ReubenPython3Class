void SendJSONmessageOverSomeSerial(int SerialPortNumber)
{

  JSONdoc["Time"] = CurrentTimeInMilliseconds/1000.0;
  //JSONdoc["AngleFloatDegrees"] = AngleFloatDegrees;
  //JSONdoc["AnalogSensor_Value_AO0"] = AnalogSensor_Value_AO0;

  double DebugVar_SmallerNumberOfDecimalPlaces = ConvertDoubleToNumberOfDecimalPlaces(DebugVar, 1);

  JSONdoc["DebugVar"] = DebugVar_SmallerNumberOfDecimalPlaces;

  String StringToSend = "";
  serializeJson(JSONdoc, StringToSend); 

  if(SerialPortNumber == 0)
  {
    StringToSend = StringToSend + "\r\n";
    SendStringOverDebuggingSerialImmediately(StringToSend);
    //Serial.println(StringToSend); //Automatically adds "\r\n" to String
  }
  else if(SerialPortNumber == 2)
  {
    StringToSend = StringToSend + "\r\n";
    SendStringOverHardwareSerial2Immediately(StringToSend);
    
    //Serial2.println(StringToSend); //Automatically adds "\r\n" to String
  }
 
}
