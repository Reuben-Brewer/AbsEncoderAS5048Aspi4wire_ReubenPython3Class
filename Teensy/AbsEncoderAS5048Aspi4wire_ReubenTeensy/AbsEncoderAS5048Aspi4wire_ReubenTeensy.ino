////////////////////////////////////////////////////////////////////////////////////////////////////

////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////
void loop() 
{

  CurrentTimeInMilliseconds = millis();
  
  double LoopDeltaTinMilliseconds = (1.0/LoopFrequencyHz)*1000.0;

  if (CurrentTimeInMilliseconds - LastTimeInMilliseconds >= LoopDeltaTinMilliseconds) 
  {
    ////////////////////////////////////////////////////////////////////////////////////////////////////
    
    ReadSPI_AS5048A(0); //SendSerialDebuggingFlag=1
    ReadAnalogInputs(0); //SendSerialDebuggingFlag=1
    
    //DebugVar = SinusoidalInput_UpdateValue(1.0); //double MagnitudeOfRandomNoiseToAdd=0.0
    DebugVar = AngleFloatDegrees;

    SendJSONmessageOverSomeSerial(2); //void SendJSONmessageOverSomeSerial(int SerialPortNumber)

    //ToggleStateOnDebuggingLED(1); //SendSerialDebuggingFlag=1
    LastTimeInMilliseconds = CurrentTimeInMilliseconds;
    ////////////////////////////////////////////////////////////////////////////////////////////////////
  }

}
