void setup() 
{
  InitializeDebuggingSerial();
  InitializeHardwareSerial2();
  delay(250); //Need to wait for serial to be initialized before we call other functions where serial debugging is required.

  InitializeDebuggingLED();

  InitializeSPI_AS5048A();

  InitializeAnalogInputs();

  InitializeJSON();
}
